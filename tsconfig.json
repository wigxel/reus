{
  "compilerOptions": {
    "types": ["vitest/globals", "node"],
    "lib": ["es2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "target": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "skipLibCheck": true,
    "allowJs": false,
    "resolveJsonModule": true,
    "jsx": "preserve",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true
  },
  "include": [
    "contexts/**/*",
    "adapters/search/**/*",
    "adapters/encryption/**/*",
    "adapters/repository/**/*",
    "adapters/utils.ts",
    "adapters/effect.util.ts",
    "adapters/pagination.service.ts",
    "shims.d.ts",
    "vitest.config.mts"
  ],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test.*"]
}
